# ─────────────────────────────────────────────────────────────
# Fitzone Supplements — environment variables
# Copy to .env.local for local development, and add the same
# keys in Vercel → Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# Public site URL (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — leave empty to run in DEMO MODE with the bundled sample catalogue.
# Public anon / publishable key. (The service-role key is only for payments — see SUPABASE_SERVICE_ROLE_KEY below, server-only.)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: verified Google Maps listing + reviews links (can also be set in Admin → Store settings)
NEXT_PUBLIC_GOOGLE_MAPS_URL=
NEXT_PUBLIC_GOOGLE_REVIEWS_URL=

# ── Online payments (Razorpay, store pickup) ─────────────────
# Set to true only when everything below is filled in and supabase/002_online_payments.sql has been run.
NEXT_PUBLIC_PAYMENTS_ENABLED=false
# Razorpay Dashboard → Account & Settings → API Keys (rzp_test_… for testing, rzp_live_… for real payments)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# SERVER-ONLY secrets — never add a NEXT_PUBLIC_ prefix to these
RAZORPAY_KEY_SECRET=
# Razorpay Dashboard → Webhooks (recommended): URL https://YOUR-DOMAIN/api/payments/razorpay/webhook
RAZORPAY_WEBHOOK_SECRET=
# Supabase → Project Settings → API Keys → service_role / secret key.
# Used ONLY by the payment routes on the server to create and confirm orders.
SUPABASE_SERVICE_ROLE_KEY=
