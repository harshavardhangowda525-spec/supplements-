# ─────────────────────────────────────────────────────────────
# Fitzone Supplements — environment variables
# Copy to .env.local for local development, and add the same
# keys in Vercel → Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# Public site URL (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — leave empty to run in DEMO MODE with the bundled sample catalogue.
# Only the anon / publishable key is used. NEVER add the service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: verified Google Maps listing + reviews links (can also be set in Admin → Store settings)
NEXT_PUBLIC_GOOGLE_MAPS_URL=
NEXT_PUBLIC_GOOGLE_REVIEWS_URL=

# Online payments — keep disabled until the business approves and the catalogue is verified.
NEXT_PUBLIC_PAYMENTS_ENABLED=false
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# Server-only secret — never prefix with NEXT_PUBLIC_
RAZORPAY_KEY_SECRET=
